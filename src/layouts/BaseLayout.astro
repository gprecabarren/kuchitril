---
import '@fontsource-variable/dm-sans';
import '@fontsource/bebas-neue';
import Icon from '../components/Icon.astro';
import Consent from '../components/Consent.astro';
import { site } from '../config/site';
import '../styles/global.css';

type Props = { title: string; description?: string; page?: 'home' | 'legal' | 'error' };
const { title, description = site.description, page = 'home' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/assets/kuchitril-referencia.webp', Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${site.url}/#organization`, name: site.name, url: site.url, logo: `${site.url}/assets/gato-bandera.webp`, slogan: 'Ideas que dejan huella.', description: site.description, email: site.email, telephone: site.phone, sameAs: [site.portfolio], founder: { '@type': 'Person', name: 'Diego Padilla Dalia', jobTitle: 'Director creativo' }, knowsAbout: ['Publicidad', 'Marketing digital', 'Desarrollo web', 'Audiovisual', 'Branding'] },
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.name, inLanguage: 'es-CL', publisher: { '@id': `${site.url}/#organization` } },
    { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical.toString(), name: title, description, inLanguage: 'es-CL', isPartOf: { '@id': `${site.url}/#website` } },
  ],
};
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c3837" />
    <meta name="google-site-verification" content={site.verification} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={page === 'error' ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Kuchitril" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content="Kuchitril, agencia de publicidad. Ideas que dejan huella." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <header class="site-header" id="site-header">
      <a class="wordmark" href="/" aria-label="Kuchitril, inicio">
        <Icon class="wordmark__mark" />
        KUCHITRIL<span class="wordmark__dot">.</span>
      </a>
      <nav class="main-nav" aria-label="Navegación principal">
        <a href="/#nosotros">Nosotros</a>
        <a href="/#servicios">Servicios</a>
        <a href={site.portfolio} target="_blank" rel="noopener noreferrer">Portafolio</a>
      </nav>
      <a class="header-contact" href={site.whatsapp} data-contact="whatsapp" target="_blank" rel="noopener noreferrer">Hablemos <Icon kind="arrow" /></a>
      <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span></button>
    </header>
    <nav class="mobile-menu" id="mobile-menu" aria-label="Navegación móvil" hidden>
      <a href="/#nosotros">Nosotros</a>
      <a href="/#servicios">Servicios</a>
      <a href={site.portfolio} target="_blank" rel="noopener noreferrer">Portafolio</a>
      <a href={site.whatsapp} data-contact="whatsapp" target="_blank" rel="noopener noreferrer">Hablemos <Icon kind="arrow" /></a>
    </nav>
    <slot />
    <footer class="site-footer">
      <div class="footer-top">
        <a class="wordmark wordmark--footer" href="/">KUCHITRIL<span class="wordmark__dot">.</span></a>
        <p>Ideas que dejan huella.</p>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Kuchitril · Agencia de publicidad</span>
        <div><a href={site.portfolio} target="_blank" rel="noopener noreferrer">Portafolio</a><a href={site.whatsapp} data-contact="whatsapp" target="_blank" rel="noopener noreferrer">WhatsApp</a></div>
      </div>
      <div class="footer-legal"><span>Santiago – Concepción</span><div><a href="/privacidad/">Privacidad</a><a href="/cookies/">Cookies</a><a href="/aviso-legal/">Aviso legal</a><button type="button" data-cookie-settings>Preferencias de cookies</button></div></div>
    </footer>
    <a class="whatsapp-float" href={site.whatsapp} data-contact="whatsapp" target="_blank" rel="noopener noreferrer" aria-label="Hablar con Kuchitril por WhatsApp">
      <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 .8a15.1 15.1 0 0 0-13 22.8L.9 31l7.6-2a15.2 15.2 0 1 0 7.5-28.2Zm0 27.6a12.5 12.5 0 0 1-6.4-1.8l-.5-.3-4.5 1.2 1.2-4.4-.3-.5A12.6 12.6 0 1 1 16 28.4Zm6.9-9.4c-.4-.2-2.2-1.1-2.5-1.2-.3-.1-.6-.2-.8.2-.2.3-.9 1.2-1.1 1.4-.2.2-.4.3-.8.1-.4-.2-1.6-.6-3.1-1.9-1.1-1-1.9-2.2-2.1-2.6-.2-.4 0-.6.2-.8l.6-.7.4-.6c.1-.2 0-.5 0-.7-.1-.2-.8-2-1.1-2.7-.3-.7-.6-.6-.8-.6h-.7c-.3 0-.7.1-1 .5-.3.4-1.3 1.3-1.3 3.1s1.4 3.5 1.6 3.7c.2.2 2.7 4.2 6.5 5.9.9.4 1.6.6 2.1.8.9.3 1.7.2 2.3.1.7-.1 2.2-.9 2.5-1.8.3-.9.3-1.7.2-1.8-.1-.2-.3-.3-.7-.5Z"/></svg>
      <span>Conversemos</span>
    </a>
    <Consent />
    <script>
      import { initSite } from '../scripts/site';
      initSite();
    </script>
  </body>
</html>
