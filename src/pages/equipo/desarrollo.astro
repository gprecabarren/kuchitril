---
import '@fontsource-variable/dm-sans';
import { getTeamMemberName } from '../../lib/content';
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, nosnippet');
Astro.response.headers.set('Cache-Control', 'private, no-store');
const memberId = Astro.url.searchParams.get('member');
const memberName = await getTeamMemberName(memberId || undefined);
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, nosnippet" />
    <title>Integrante del equipo</title>
  </head>
  <body><h4>{memberName}</h4></body>
</html>
<style>
  :global(html), :global(body){margin:0;padding:0;background:transparent;color:#f7efdf;font-family:'DM Sans Variable',Arial,sans-serif;font-synthesis:none}
  h4{font-size:clamp(1.05rem,6vw,1.3rem);font-weight:600;line-height:1.35;letter-spacing:-.03em;margin:0;overflow-wrap:break-word}
</style>
