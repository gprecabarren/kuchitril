---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { getSiteContent, safeExternalUrl, safeMediaUrl } from '../lib/content';
const content = await getSiteContent();
const { settings, works, testimonials } = content;
const portfolioUrl = safeExternalUrl(settings.portfolio_url) || site.portfolio;
const videoUrl = safeMediaUrl(settings.video_url);
const videoPoster = safeMediaUrl(settings.video_poster_url);
const founderPhoto = safeMediaUrl(settings.founder_photo_url) || '/assets/fundador.webp';
const videoMime = ['video/mp4', 'video/webm', 'video/ogg'].includes(settings.video_mime) ? settings.video_mime : undefined;
const safeColor = (value: string, fallback: string) => /^#[0-9a-f]{6}$/i.test(value) ? value : fallback;
const services = ['Marketing digital', 'Desarrollo web', 'Audiovisual', 'Branding'];
const fallbackTeam = [
  { id: '', name: '', role: 'Programación y Desarrollo web.', photo_url: '', photo_alt: '', exclude_name_from_index: true },
  { id: '', name: 'Julián Díaz A.', role: 'Animador multimedia y motiongrapher.', photo_url: '', photo_alt: '', exclude_name_from_index: false },
  { id: '', name: 'Fernanda Lagos', role: 'Diseño, ilustración y dirección de arte.', photo_url: '', photo_alt: '', exclude_name_from_index: false },
];
const team = content.configured ? content.team : fallbackTeam;
const voices = testimonials.length ? testimonials : [1, 2, 3].map((number) => ({ id: `placeholder-${number}`, quote: 'Espacio para testimonio.', name: '', company: 'UN ESPACIO PARA NUESTROS CLIENTES', photo_url: '', background_color: ['#0c3837', '#f6a326', '#52ada4'][number - 1], text_color: number === 1 ? '#f7efdf' : '#0c3837', sort_order: number }));
---
<BaseLayout title={settings.home_title || 'Kuchitril | Agencia de publicidad · Ideas que dejan huella'} description={settings.home_description || site.description} settings={settings} page="home">
  <div class="intro" id="intro" role="presentation">
    <button class="intro__skip" id="skip-intro" type="button">Saltar intro <Icon kind="arrow" /></button>
    <div class="intro__scene">
      <div class="intro__orbit" aria-hidden="true"></div>
      <div class="intro__mascot-wrap"><img class="intro__mascot" src="/assets/gato-bandera.webp" alt="" width="520" height="650" /></div>
      <span class="intro__ground" aria-hidden="true"></span>
      <p class="intro__caption">Toda gran idea reclama su lugar.</p>
    </div>
    <span class="intro__counter" aria-hidden="true">K / 001</span>
  </div>
  <main id="contenido">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero__noise" aria-hidden="true"></div>
      <div class="hero__eyebrow"><span class="micro-line"></span> AGENCIA DE PUBLICIDAD <span class="hero__location">Santiago – Concepción</span></div>
      <div class="hero__grid">
        <div class="hero__copy">
          <h1 id="hero-title"><span class="hero__line">Una buena</span><span class="hero__line hero__line--accent">idea merece</span><span class="hero__line">hacerse ver<span class="hero__period">.</span></span></h1>
        </div>
        <div class="hero__art" aria-hidden="true">
          <div class="hero__art-ring"></div>
          <span class="hero__art-label hero__art-label--top">IDEAS / ACCIÓN / IMPACTO</span>
          <img src="/assets/gato-bandera.webp" alt="" fetchpriority="high" width="520" height="650" />
          <span class="hero__art-label hero__art-label--bottom">PLANTAMOS IDEAS EN LA MENTE</span>
          <div class="hero__art-stamp">K<Icon /></div>
        </div>
        <div class="hero__bottom">
          {videoUrl ? <div class="hero-video">
            <video controls playsinline preload="metadata" poster={videoPoster || undefined} autoplay={settings.video_autoplay} muted={settings.video_autoplay} aria-label="Video de presentación de Kuchitril">
              <source src={videoUrl} type={videoMime} />
              Tu navegador no admite este video. <a href={videoUrl}>Ver el video</a>
            </video>
            <p class="hero-video__error" hidden>No se pudo reproducir el video. <a href={videoUrl} target="_blank" rel="noopener noreferrer">Abrir el video</a></p>
          </div> : <div class="video-placeholder" aria-label="Espacio reservado para el video de presentación">
            <span class="video-placeholder__play"><Icon kind="play" /></span>
            <span><strong>Insertar el video</strong></span>
          </div>}
          <a class="circle-link" href="#nosotros" aria-label="Conocer al equipo"><Icon kind="down" /></a>
        </div>
      </div>
      <div class="hero__footer"><span>DESLIZA PARA EXPLORAR</span><span>IDEAS QUE DEJAN HUELLA</span></div>
    </section>
    <div class="ticker" aria-hidden="true"><div class="ticker__track">{[0, 1].map(() => <Fragment>CREAMOS <Icon /> MOVEMOS <Icon /> CONECTAMOS <Icon /> </Fragment>)}</div></div>
    <section class="manifesto section-shell" aria-labelledby="manifesto-title">
      <div class="section-index"><span>01 / LO QUE CREEMOS</span><span>EL PODER DE HACER SENTIR</span></div>
      <div class="manifesto__layout">
        <Icon class="manifesto__asterisk" />
        <blockquote class="manifesto__quote"><h2 id="manifesto-title">«La gente olvidará lo que dijiste, olvidará lo que hiciste, pero nunca olvidará <em>cómo la hiciste sentir</em>»</h2></blockquote>
        <p class="manifesto__aside">Volvamos al origen y pongamos el foco en la diferenciación, en la experiencia y en la empatía.</p>
      </div>
    </section>
    <section class="founder section-shell" id="nosotros" aria-labelledby="founder-title">
      <div class="section-index"><span>02 / DETRÁS DE LA IDEA</span><span>PERSONAS ANTES QUE PANTALLAS</span></div>
      <div class="founder__grid">
        <div class="founder__photo-wrap">
          <div class="founder__photo-frame"><img src={founderPhoto} alt="Diego Padilla Dalia, director creativo" loading="lazy" /></div>
          <span class="founder__photo-tag">DIRECTOR CREATIVO</span>
          <Icon class="founder__photo-star" />
          <div class="founder__experience"><strong>10+</strong><span>AÑOS DE EXPERIENCIA</span></div>
        </div>
        <div class="founder__copy">
          <h2 id="founder-title">Las ideas tienen <em>un rostro.</em></h2>
          <p>Con más de 10 años de experiencia, <strong>Diego Padilla Dalia</strong> es el publicista fundador de este laboratorio creativo. Ha trabajado con grandes marcas a nivel nacional como Volkswagen, Gobierno de Chile, Tiendas Sparta, Salfa Agrícola, Huawei, Fiat, Tramontina Store y Clínica UC Christus, desarrollando, creando e implementando diferentes campañas publicitarias, tanto para medios convencionales como para redes sociales.</p>
          <p>Además, es especialista en redacción, tiene un diplomado en escritura de guión cinematográfico, se desempeñó durante tres años como académico en la Universidad Santo Tomás en la Carrera de Comunicación Audiovisual y ha sido invitado en varias ocasiones a dar charlas de narrativas, procesos creativos y comunicación estratégica en diferentes institutos y universidades.</p>
          <ul class="founder__credits">
            <li>Director del cortometraje “El Dilema”.</li>
            <li>Director del documental “Campus Naturaleza” de la Universidad de Concepción.</li>
            <li>Director del documental “Matriarca”.</li>
          </ul>
        </div>
      </div>
      {team.length > 0 && <div class="team" aria-labelledby="team-title">
        <div class="team__heading"><span class="eyebrow">DISTINTAS MIRADAS, UNA MISMA IDEA</span><h3 id="team-title">El equipo.</h3></div>
        <div class="team__grid">{team.map((person, index) => <article class="team-card">
          <div class:list={['team-card__portrait', { 'team-card__portrait--photo': safeMediaUrl(person.photo_url) }]}>
            <span class="team-card__number">{String(index + 1).padStart(2, '0')}</span>
            {safeMediaUrl(person.photo_url) ? <img src={safeMediaUrl(person.photo_url)} alt={person.exclude_name_from_index ? 'Integrante del equipo' : person.photo_alt || person.name} loading="lazy" /> : <><Icon kind="portrait" /><span>Foto del equipo</span></>}
          </div>
          {person.exclude_name_from_index ? <iframe class="team-card__name" src={`/equipo/desarrollo/${person.id ? `?member=${encodeURIComponent(person.id)}` : ''}`} title="Integrante del equipo" loading="lazy"></iframe> : <h4>{person.name}</h4>}<p>{person.role}</p>
        </article>)}</div>
      </div>}
    </section>
    <section class="services section-shell" id="servicios" aria-labelledby="services-title">
      <div class="section-index"><span>03 / QUÉ HACEMOS</span><span>CUATRO FORMAS DE MOVER TU MARCA</span></div>
      <div class="services__heading"><h2 id="services-title">Ideas en<br /><em>todas sus formas.</em></h2><p>Una misma intención: hacer que tu marca encuentre su lugar y se quede en la memoria.</p></div>
      <div class="services__list">{services.map((service, index) => <article class="service-row"><span class="service-row__num">0{index + 1}</span><div><h3>{service}</h3><p class="service-row__pending">Descripción del servicio</p></div><Icon kind="arrow" class="service-row__icon" /></article>)}</div>
    </section>
    <section class="portfolio-preview section-shell" id="portafolio" aria-labelledby="portfolio-title">
      <div class="section-index"><span>04 / TRABAJO EN MOVIMIENTO</span><span>PORTAFOLIO</span></div>
      <div class="portfolio-preview__heading"><h2 id="portfolio-title"><span class="portfolio-formula__intro">La fórmula es simple:</span>No necesitas miles de clientes nuevos.<br /><em>Necesitas conservar los clientes, que ya tienes.</em></h2><a class="text-link" href={portfolioUrl} target="_blank" rel="noopener noreferrer">Ver portafolio completo <Icon kind="arrow" /></a></div>
      <div class="project-grid">{works.length ? works.map((work, index) => <article class="project-card project-card--published">
        <div class="project-card__media"><span class="project-card__number">{String(index + 1).padStart(2, '0')}</span>{safeMediaUrl(work.image_url) ? <img src={safeMediaUrl(work.image_url)} alt={work.image_alt || work.title} loading="lazy" /> : <Icon class="project-card__empty" />}</div>
        <div class="project-card__content"><div class="project-card__meta"><span>{work.category || 'PORTAFOLIO'}</span><span>{work.client}</span></div><h3>{safeExternalUrl(work.link_url) ? <a href={safeExternalUrl(work.link_url)} target="_blank" rel="noopener noreferrer">{work.title} <Icon kind="arrow" /></a> : work.title}</h3><p>{work.description}</p></div>
      </article>) : [1, 2, 3, 4].map((number) => <div class="project-card work-placeholder"><div class="work-placeholder__media"><span class="work-placeholder__number">0{number}</span><Icon /><span>Espacio para material</span></div><div class="work-placeholder__caption"><span>TRABAJO / 0{number}</span><span>Portafolio</span></div></div>)}</div>
      <div class="portfolio-preview__foot"><p>{works.length ? 'Más ideas y proyectos en nuestro portafolio.' : 'Mientras preparamos esta selección, conoce los trabajos en Behance.'}</p><a class="pill-link" href={portfolioUrl} target="_blank" rel="noopener noreferrer">Explorar portafolio <Icon kind="arrow" /></a></div>
    </section>
    <section class="voices section-shell" aria-labelledby="voices-title">
      <div class="section-index"><span>05 / VOCES QUE IMPORTAN</span><span>EXPERIENCIAS COMPARTIDAS</span></div>
      <div class="voices__heading"><h2 id="voices-title">Lo mejor lo cuentan <em>quienes estuvieron ahí.</em></h2><p>Las experiencias de quienes han compartido este camino.</p></div>
      <div class="voices__carousel" data-voices-carousel>
        <div class="voices__viewport" tabindex="0" role="region" aria-label="Testimonios de clientes. Desliza para recorrerlos."><div class="voices__track">{[false, true].map((duplicate) => <div class="voices__group" aria-hidden={duplicate ? 'true' : undefined} inert={duplicate ? true : undefined}>{voices.map((voice, index) => <article class="voice-card" style={`--voice-background:${safeColor(voice.background_color, '#0c3837')};--voice-color:${safeColor(voice.text_color, '#f7efdf')}`}>
          <span class="voice-card__number">TESTIMONIO / {String(index + 1).padStart(2, '0')}</span><span class="voice-card__quote" aria-hidden="true">“</span><p>{voice.quote}</p>
          <div class="voice-card__author">{safeMediaUrl(voice.photo_url) && <img src={safeMediaUrl(voice.photo_url)} alt="" loading="lazy" width="56" height="56" />}<div>{voice.name && <strong>{voice.name}</strong>}<span class="voice-card__meta">{voice.company}</span></div></div>
        </article>)}</div>)}</div></div>
        <div class="voices__controls"><span>Historias que nos mueven.</span><div><button type="button" data-voices-prev aria-label="Testimonio anterior"><Icon kind="down" /></button><button type="button" class="voices__pause" data-voices-pause aria-pressed="false">Pausar movimiento</button><button type="button" data-voices-next aria-label="Siguiente testimonio"><Icon kind="down" /></button></div></div>
      </div>
    </section>
    <section class="contact section-shell" id="contacto" aria-labelledby="contact-title">
      <Icon class="contact__orb" /><span class="eyebrow">TU IDEA TIENE UN LUGAR AQUÍ</span>
      <h2 id="contact-title">¿Plantamos<br /><em>la próxima?</em></h2>
      <div class="contact__bottom"><p>Cuéntanos qué tienes en mente. Construyamos algo que valga la pena mirar.</p><a class="contact__button" href={site.whatsapp} data-contact="whatsapp" target="_blank" rel="noopener noreferrer">Hablemos por WhatsApp <Icon kind="arrow" /></a></div>
    </section>
  </main>
</BaseLayout>
