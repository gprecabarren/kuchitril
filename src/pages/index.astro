---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { starterProjects } from '../data/projects';
const featured = starterProjects.filter((project) => project.featured).sort((a, b) => a.order - b.order);
---
<BaseLayout title="Kuchitril — Ideas que dejan huella" page="home">
  <div class="intro" id="intro" role="presentation">
    <button class="intro__skip" id="skip-intro" type="button">Saltar intro <span aria-hidden="true">↗</span></button>
    <div class="intro__scene">
      <div class="intro__orbit" aria-hidden="true"></div>
      <div class="intro__mascot-wrap"><img class="intro__mascot" src="/assets/gato-bandera.webp" alt="" /></div>
      <span class="intro__ground" aria-hidden="true"></span>
      <p class="intro__caption">Toda gran idea reclama su lugar.</p>
    </div>
    <span class="intro__counter" aria-hidden="true">K / 001</span>
  </div>

  <main id="contenido">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero__noise" aria-hidden="true"></div>
      <div class="hero__eyebrow"><span class="micro-line"></span> ESTUDIO CREATIVO · CHILE <span class="hero__edition">EDICIÓN 001 / 2026</span></div>
      <div class="hero__grid">
        <div class="hero__copy">
          <p class="eyebrow hero__kicker">PUBLICIDAD CON INSTINTO</p>
          <h1 id="hero-title"><span class="hero__line">Una buena</span><span class="hero__line hero__line--accent">idea merece</span><span class="hero__line">hacerse ver<span class="hero__period">.</span></span></h1>
          <div class="hero__bottom"><p>Le damos forma a marcas, sitios y contenidos para que destaquen en el mundo digital.</p><a class="circle-link" href="#servicios" aria-label="Descubrir servicios"><span aria-hidden="true">↓</span></a></div>
        </div>
        <div class="hero__art" aria-hidden="true">
          <div class="hero__art-ring"></div>
          <span class="hero__art-label hero__art-label--top">IDEAS / ACCIÓN / IMPACTO</span>
          <img src="/assets/gato-bandera.webp" alt="" fetchpriority="high" />
          <span class="hero__art-label hero__art-label--bottom">PLANTAMOS IDEAS EN LA MENTE</span>
          <div class="hero__art-stamp">K<span>★</span></div>
        </div>
      </div>
      <div class="hero__footer"><span>DESLIZA PARA EXPLORAR</span><span>01 / 05</span></div>
    </section>

    <div class="ticker" aria-hidden="true"><div class="ticker__track">CREAMOS <span>✳</span> MOVEMOS <span>✳</span> CONECTAMOS <span>✳</span> CREAMOS <span>✳</span> MOVEMOS <span>✳</span> CONECTAMOS <span>✳</span></div></div>

    <section class="manifesto section-shell" aria-labelledby="manifesto-title">
      <div class="section-index"><span>01 / LO QUE CREEMOS</span><span>EL PODER DE HACER</span></div>
      <div class="manifesto__layout">
        <p class="manifesto__asterisk" aria-hidden="true">✳</p>
        <h2 id="manifesto-title" class="reveal-words">En un mundo que nunca deja de mirar, <em>lo que haces sentir</em> es lo que permanece.</h2>
        <p class="manifesto__aside">La presencia digital se construye con ideas claras, contenido relevante y experiencias que invitan a volver.</p>
      </div>
    </section>

    <section class="founder section-shell" id="nosotros" aria-labelledby="founder-title">
      <div class="section-index"><span>02 / DETRÁS DE LA IDEA</span><span>PERSONAS ANTES QUE PANTALLAS</span></div>
      <div class="founder__grid">
        <div class="founder__photo-wrap">
          <div class="founder__photo-frame"><img src="/assets/fundador.webp" alt="Fundador de Kuchitril en una presentación audiovisual" loading="lazy" /></div>
          <span class="founder__photo-tag">FUNDADOR / KUCHITRIL</span>
          <span class="founder__photo-star" aria-hidden="true">✳</span>
        </div>
        <div class="founder__copy">
          <span class="eyebrow">AL FRENTE DE KUCHITRIL</span>
          <h2 id="founder-title">Las ideas tienen <em>un rostro.</em></h2>
          <p>Detrás de Kuchitril hay una mirada que une estrategia, creatividad y oficio audiovisual para transformar lo que una marca quiere decir en algo que la gente quiera ver.</p>
          <div class="founder__stat"><strong>10<span>+</span></strong><span>AÑOS DE<br />EXPERIENCIA</span></div>
          <p class="founder__note">Trayectoria junto a distintas marcas y proyectos. Los nombres y casos se incorporarán con el material aprobado por el cliente.</p>
        </div>
      </div>
    </section>

    <section class="services section-shell" id="servicios" aria-labelledby="services-title">
      <div class="section-index"><span>03 / QUÉ HACEMOS</span><span>CUATRO FORMAS DE MOVER TU MARCA</span></div>
      <div class="services__heading"><h2 id="services-title">Ideas en<br /><em>todas sus formas.</em></h2><p>Una misma intención: hacer que tu marca encuentre su lugar y se quede en la memoria.</p></div>
      <div class="services__list">
        <article class="service-row"><span class="service-row__num">01</span><div><h3>Marketing digital</h3><p>Haz crecer tu marca en redes sociales. Estrategia y contenido para conectar, posicionarte y convertir atención en oportunidades.</p></div><span class="service-row__icon" aria-hidden="true">↗</span></article>
        <article class="service-row"><span class="service-row__num">02</span><div><h3>Desarrollo web</h3><p>Dale a tu marca un sitio a su altura: landing pages, sitios corporativos y tiendas online preparadas para mostrar y vender.</p></div><span class="service-row__icon" aria-hidden="true">↗</span></article>
        <article class="service-row"><span class="service-row__num">03</span><div><h3>Audiovisual</h3><p>Spots y contenido que cuentan algo. Grabación, edición y tomas con dron para ver tu historia desde otra perspectiva.</p></div><span class="service-row__icon" aria-hidden="true">↗</span></article>
        <article class="service-row"><span class="service-row__num">04</span><div><h3>Branding</h3><p>Una identidad que se reconoce en cada detalle: sistema visual, papelería y elementos corporativos que elevan el valor de tu producto.</p></div><span class="service-row__icon" aria-hidden="true">↗</span></article>
      </div>
    </section>

    <section class="portfolio-preview section-shell" id="portafolio" aria-labelledby="portfolio-title">
      <div class="section-index"><span>04 / TRABAJO EN MOVIMIENTO</span><span>SELECCIÓN EDITORIAL</span></div>
      <div class="portfolio-preview__heading"><div><span class="eyebrow">PORTAFOLIO</span><h2 id="portfolio-title">Las ideas se<br /><em>ven mejor hechas.</em></h2></div><a class="text-link" href="/portafolio/">Ver portafolio completo <span aria-hidden="true">↗</span></a></div>
      <p class="prototype-note">Vista de prototipo: estas láminas son ejemplos de presentación y se reemplazarán por proyectos confirmados.</p>
      <div class="project-grid" id="featured-projects" data-featured-grid>{featured.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
      <div class="portfolio-preview__foot"><p>Los destacados pueden elegirse desde el <a href="/admin/">panel demo</a>.</p><a class="pill-link" href="/portafolio/">Explorar todo el portafolio <span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="voices section-shell" aria-labelledby="voices-title">
      <div class="section-index"><span>05 / VOCES QUE IMPORTAN</span><span>PRÓXIMAMENTE</span></div>
      <div class="voices__heading"><h2 id="voices-title">Lo mejor lo cuentan <em>quienes estuvieron ahí.</em></h2><p>Este espacio quedará para testimonios reales y marcas autorizadas.</p></div>
      <div class="voices__viewport"><div class="voices__track">
        <div class="voice-card"><span class="voice-card__number">TESTIMONIO / 01</span><span class="voice-card__quote">“</span><p>Una historia compartida por un cliente irá aquí.</p><span class="voice-card__meta">NOMBRE Y MARCA · PENDIENTE</span></div>
        <div class="voice-card"><span class="voice-card__number">TESTIMONIO / 02</span><span class="voice-card__quote">“</span><p>El resultado de una colaboración, contado en primera persona.</p><span class="voice-card__meta">NOMBRE Y MARCA · PENDIENTE</span></div>
        <div class="voice-card"><span class="voice-card__number">TESTIMONIO / 03</span><span class="voice-card__quote">“</span><p>Palabras reales que muestran el impacto del trabajo.</p><span class="voice-card__meta">NOMBRE Y MARCA · PENDIENTE</span></div>
      </div></div>
    </section>

    <section class="contact section-shell" id="contacto" aria-labelledby="contact-title">
      <div class="contact__orb" aria-hidden="true">✳</div>
      <span class="eyebrow">TU IDEA TIENE UN LUGAR AQUÍ</span>
      <h2 id="contact-title">¿Plantamos<br /><em>la próxima?</em></h2>
      <div class="contact__bottom"><p>Cuéntanos qué tienes en mente. Construyamos algo que valga la pena mirar.</p><a class="contact__button" href="https://wa.me/56991950914?text=Hola%20Kuchitril%2C%20quiero%20conversar%20sobre%20mi%20marca" target="_blank" rel="noopener noreferrer">Hablemos por WhatsApp <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>
  <script>
    import { renderProjectGrid } from '../lib/portfolio';
    const grid = document.querySelector<HTMLElement>('[data-featured-grid]');
    if (grid) renderProjectGrid(grid, true);
  </script>
</BaseLayout>
